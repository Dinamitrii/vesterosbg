{
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "previews": {}
  },
  "name": "vesterosbg",
  "compatibility_date": "2026-11-13",
  "main": "app.py",
  "assets": {
    "directory": "./static"
  }
}