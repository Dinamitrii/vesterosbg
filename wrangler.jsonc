{
  "name": "vesterosbg",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-11-13",
  "main": "app.py",
  "rules": [
    { "type": "Text", "globs": ["templates/*.html", "templates/*.json"] },
    { "type": "Data", "globs": ["static/*", "static/**/*"] }
  ],
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "vesterosbg.online",
      "custom_domain": true
    },
    {
      "pattern": "www.vesterosbg.online",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vesterosbg-db",
      "database_id": "35dd8f5d-8e52-436c-b327-30835552b034"
    }
  ],
  "vars": {
    "SITE_URL": "https://vesterosbg.online",
    "WHATSAPP_PHONE": "359876641667"
  },
  "secrets": {
    "required": ["SECRET_KEY", "AUTH_PEPPER", "ADMIN_PASSWORD"]
  }
}