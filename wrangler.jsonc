{
  "name": "vesterosbg",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-11-13",
  "main": "app.py",
  "assets": {
    "directory": "./static"
  },
  "vars": {
    "SITE_URL": "https://vesterosbg.online",
    "WHATSAPP_PHONE": "359876641667"
  },
  "secrets": {}
}